<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>appiconv2.ico</ApplicationIcon>
		<SignAssembly>False</SignAssembly>
		<AssemblyName>BambuMan</AssemblyName>
		<PublishDir>bin\Release\net10.0-windows\publish\win-x64\</PublishDir>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>

		<!-- Only the Android app is translated (Program pins SharedResources to English); don't ship the et/de satellites.
		     SatelliteResourceLanguages filters the packages' satellites; the project references' ones (BambuMan.Shared)
		     are found next to their assemblies unless the related-satellite lookup is off. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<ResolveAssemblyReferencesFindRelatedSatellites>false</ResolveAssemblyReferencesFindRelatedSatellites>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="appiconv2.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bambuddy.Api\Bambuddy.Api.csproj" />
		<ProjectReference Include="..\BambuMan.Shared\BambuMan.Shared.csproj" />
		<ProjectReference Include="..\SpoolMan.Api\SpoolMan.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="PCSC" Version="7.0.1" />
		<PackageReference Include="PCSC.Iso7816" Version="7.0.1" />
	</ItemGroup>

</Project>