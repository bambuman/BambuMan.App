@page "/write-tag"
@implements IDisposable

<PageHeader Title="@AppResources.WriteTag_Title" Icon="Lucide.Pencil">
    <Subtitle>@AppResources.WriteTag_Subtitle</Subtitle>
</PageHeader>

<div class="stack">

    <Banner Kind="error" Label="@AppResources.Main_BannerError" Icon="Lucide.CircleAlert" Message="@(ScannerService.CanWriteTags ? null : AppResources.WriteTag_CantWrite)" />

    <div class="card">
        <div class="card-header">
            <div class="card-title"><Blazicon Svg="Lucide.Nfc" /> OpenSpool</div>
            @if (Scanner.LastReadTag != null)
            {
                <button class="btn btn-secondary btn-sm" disabled="@Scanner.IsTagWritePending" @onclick="CopyLastRead"><Blazicon Svg="Lucide.Package" /> @AppResources.WriteTag_CopyLastRead</button>
            }
        </div>

        <form class="form-grid" @onsubmit="Write" @onsubmit:preventDefault>
            <FormField Label="@AppResources.WriteTag_Brand" Icon="Lucide.Factory" Help="@AppResources.WriteTag_BrandHelp" HasValue="!string.IsNullOrEmpty(model.Brand)" OnClear="() => model.Brand = null">
                <input type="text" autocomplete="off" @bind="model.Brand" />
            </FormField>

            <FormField Label="@AppResources.Common_Material" Icon="Lucide.Layers" Error="@model.MaterialError">
                <input type="text" list="write-tag-materials" autocomplete="off" autocapitalize="characters" @bind="model.Material" />
                <datalist id="write-tag-materials">
                    @foreach (var material in WriteTagModel.CommonMaterials)
                    {
                        <option value="@material"></option>
                    }
                </datalist>
            </FormField>

            <FormField Label="@AppResources.Common_Colour" Icon="Lucide.Palette">
                <input type="color" @bind="model.Color" />
            </FormField>

            <FormField Label="@AppResources.WriteTag_MinTemperature" Icon="Lucide.Thermometer" Error="@model.TemperatureError">
                <input type="number" inputmode="numeric" step="1" min="0" max="500" @bind="model.MinTemperature" />
            </FormField>

            <FormField Label="@AppResources.WriteTag_MaxTemperature" Icon="Lucide.Thermometer">
                <input type="number" inputmode="numeric" step="1" min="0" max="500" @bind="model.MaxTemperature" />
            </FormField>

            <div class="form-actions span-2">
                @if (Scanner.IsTagWritePending)
                {
                    <button type="button" class="btn btn-tertiary" @onclick="Scanner.CancelTagWrite">@AppResources.Common_Cancel</button>
                }
                <button type="submit" class="btn btn-primary" disabled="@(Scanner.IsTagWritePending || !ScannerService.CanWriteTags)"><Blazicon Svg="Lucide.Nfc" /> @AppResources.WriteTag_Title</button>
            </div>
        </form>
    </div>

    @if (Scanner.IsTagWritePending)
    {
        <div class="card connecting">
            <div class="spinner"></div>
            @AppResources.WriteTag_Waiting
        </div>
    }

    <div class="small subtle">
        @AppResources.WriteTag_Footer
    </div>

</div>
