@page "/spools"
@inherits ObservingComponentBase

<PageHeader Title="@AppResources.Spools_Title" Icon="Lucide.Boxes">
    <Subtitle>@Vm.CountText</Subtitle>
    <Actions>
        @if (Vm.SendBackend is { } backend)
        {
            <button class="btn btn-primary" disabled="@(Scanner.IsSendingSpools || Vm.FilteredKeys.Count == 0)" @onclick="SendAsync"><Blazicon Svg="Lucide.Send" /> @(Vm.IsFiltered ? string.Format(AppResources.Spools_SendCountTo, Vm.FilteredKeys.Count, backend.DisplayName()) : string.Format(AppResources.Spools_SendTo, backend.DisplayName()))</button>
        }
        <button class="btn btn-secondary" @onclick="Scanner.ImportCsvAsync"><Blazicon Svg="Lucide.FileUp" /> @AppResources.Common_ImportCsv</button>
        <button class="btn btn-secondary" @onclick="Scanner.ExportCsvAsync"><Blazicon Svg="Lucide.FileDown" /> @AppResources.Common_ExportCsv</button>
        <button class="btn btn-tertiary" disabled="@(Vm.TotalCount == 0)" @onclick="DeleteAllAsync"><Blazicon Svg="Lucide.Trash" /> @AppResources.Spools_DeleteAll</button>
    </Actions>
</PageHeader>

<div class="stack">

    @if (Vm.SendBackend is { } target && Vm.TotalCount > 0 && Scanner.SendProgress == null && Scanner.LastSendSummary == null)
    {
        <Banner Kind="info" Icon="Lucide.Info" Message="@(string.Format(AppResources.Spools_SendBanner, target.DisplayName()))" />
    }

    @if (Scanner.SendProgress is { } progress)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title"><Blazicon Svg="Lucide.Send" /> @(string.Format(AppResources.Spools_SendingTo, Vm.SendBackend?.DisplayName() ?? AppResources.Spools_Server))</div>
                <button class="btn btn-secondary btn-sm" disabled="@cancelRequested" @onclick="Cancel"><Blazicon Svg="Lucide.X" /> @(cancelRequested ? AppResources.Spools_Stopping : AppResources.Spools_Stop)</button>
            </div>

            <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@progress.Total" aria-valuenow="@progress.Done">
                <div style="width: @((progress.Total == 0 ? 0 : progress.Done * 100 / progress.Total).ToString(CultureInfo.InvariantCulture))%"></div>
            </div>

            <div class="small subtle send-progress-text">
                @(progress.Current == null && progress.Done == 0 ? AppResources.Spools_SendConnecting : progress.Current == null ? string.Format(AppResources.Spools_SendProgress, progress.Done, progress.Total) : string.Format(AppResources.Spools_SendProgressCurrent, progress.Done, progress.Total, progress.Current.Title))
            </div>
        </div>
    }

    @if (Scanner.LastSendSummary is { } summary)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title"><Blazicon Svg="@(summary.Failed > 0 ? Lucide.TriangleAlert : Lucide.CircleCheck)" /> @summary.Text</div>
                <button class="btn btn-secondary btn-sm" @onclick="Scanner.DismissSendSummary"><Blazicon Svg="Lucide.X" /> @AppResources.Common_Close</button>
            </div>

            @if (summary.Failed > 0)
            {
                <div class="list">
                    @foreach (var failure in summary.Failures)
                    {
                        <div class="list-row" @key="failure.Spool.Key">
                            <a class="list-row-main" href="spools/@failure.Spool.Key">
                                <div class="list-row-text">
                                    <div class="list-row-title">@failure.Spool.Title</div>
                                    <div class="list-row-sub send-failure">@failure.Message</div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <p class="small subtle">@AppResources.Spools_SendFailuresHint</p>
            }

            @* The server had less filament left on these than stored here, so it kept its own weight. *@
            @if (summary.WeightsKept.Any())
            {
                <div class="list">
                    @foreach (var kept in summary.WeightsKept)
                    {
                        <div class="list-row" @key="kept.Spool.Key">
                            <a class="list-row-main" href="spools/@kept.Spool.Key">
                                <div class="list-row-text">
                                    <div class="list-row-title">@kept.Spool.Title</div>
                                    <div class="list-row-sub">@kept.StatusText</div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }

            @if (summary.Failed == 0)
            {
                <p class="small subtle">@AppResources.Spools_SendKeptHint</p>
            }
        </div>
    }

    @if (Vm.TotalCount > 0)
    {
        <div class="filters">
            <FormField Icon="Lucide.Search" Class="filter-search" HasValue="!string.IsNullOrEmpty(Vm.Search)" OnClear="() => Vm.Search = null">
                <input type="text" enterkeyhint="search" placeholder="@AppResources.Spools_Search" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="@AppResources.Spools_Search" @bind="Vm.Search" @bind:event="oninput" />
            </FormField>

            <FormField Icon="Lucide.MapPin" Class="filter-location">
                <select aria-label="@AppResources.Spool_Location" @bind="Vm.Location">
                    <option value="">@AppResources.Spools_AllLocations</option>
                    @foreach (var location in Vm.Locations)
                    {
                        <option value="@location">@location</option>
                    }
                </select>
            </FormField>

            @if (Vm.SendBackend is { } sentTo)
            {
                <FormField Icon="Lucide.Send" Class="filter-location">
                    <select aria-label="@(string.Format(AppResources.Spools_SentTo, sentTo.DisplayName()))" @bind="Vm.Sent">
                        <option value="@LocalSpoolSentFilter.All">@AppResources.Spools_FilterAll</option>
                        <option value="@LocalSpoolSentFilter.NotSent">@(string.Format(AppResources.Spools_NotSentTo, sentTo.DisplayName()))</option>
                        <option value="@LocalSpoolSentFilter.Sent">@(string.Format(AppResources.Spools_SentTo, sentTo.DisplayName()))</option>
                    </select>
                </FormField>
            }
        </div>
    }

    <div class="card">
        @if (Vm.TotalCount == 0)
        {
            <div class="empty">@(Vm.SendBackend == null ? AppResources.Spools_Empty : AppResources.Spools_EmptyOnDevice)</div>
        }
        else if (Vm.Groups.Count == 0)
        {
            <div class="empty">
                @AppResources.Spools_NoMatch
                <div><button class="btn btn-outline btn-sm" @onclick="Vm.ClearFilters">@AppResources.Spools_ClearFilter</button></div>
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var group in Vm.Groups)
                {
                    if (group.Count == 1)
                    {
                        var spool = group.Spools[0];

                        <div class="list-row" @key="group.Key">
                            <a class="list-row-main" href="spools/@spool.Key">
                                <div class="swatch round" style="background: @SpoolSwatch.ToCss(spool.Color)"></div>
                                <div class="list-row-text">
                                    <div class="list-row-title">@spool.Title @if (Vm.IsSent(spool.Spool)) { <span class="pill success">@AppResources.Spools_Sent</span> }</div>
                                    <div class="list-row-sub">@spool.Subtitle</div>
                                </div>
                            </a>
                            <button class="btn btn-secondary btn-sm" aria-label="@(string.Format(AppResources.Spools_DeleteSpool, spool.Title))" @onclick="() => DeleteAsync(spool.Key)"><Blazicon Svg="Lucide.Trash" /></button>
                        </div>
                    }
                    else
                    {
                        var open = IsExpanded(group);

                        <div class="group @(open ? "open" : null)" @key="group.Key">
                            <button type="button" class="list-row group-head" aria-expanded="@open" @onclick="() => Toggle(group)">
                                <div class="swatch round" style="background: @SpoolSwatch.ToCss(group.Color)"></div>
                                <div class="list-row-text">
                                    <div class="list-row-title">@group.Title <span class="pill primary">× @group.Count</span></div>
                                    <div class="list-row-sub">@(string.IsNullOrEmpty(group.Locations) ? AppResources.Common_NoLocation : group.Locations)</div>
                                </div>
                                <Blazicon Svg="Lucide.ChevronDown" class="group-chevron" />
                            </button>

                            @if (open)
                            {
                                <div class="group-items">
                                    @foreach (var spool in group.Spools)
                                    {
                                        <div class="list-row" @key="spool.Key">
                                            <a class="list-row-main" href="spools/@spool.Key">
                                                <div class="list-row-text">
                                                    <div class="small">@(spool.Location ?? AppResources.Common_NoLocation) · @spool.Spool.LastScanned.ToString("yyyy-MM-dd") @if (Vm.IsSent(spool.Spool)) { <span class="pill success">@AppResources.Spools_Sent</span> }</div>
                                                    <div class="list-row-sub @(spool.Spool.IsManual ? null : "mono")">@spool.Tag</div>
                                                </div>
                                            </a>
                                            <button class="btn btn-secondary btn-sm" aria-label="@(string.Format(AppResources.Spools_DeleteSpool, spool.Title))" @onclick="() => DeleteAsync(spool.Key)"><Blazicon Svg="Lucide.Trash" /></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

</div>
