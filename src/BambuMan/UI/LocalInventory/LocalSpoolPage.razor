@page "/spools/{Key}"

@if (loading)
{
    <div class="card connecting">
        <div class="spinner"></div>
    </div>
}
else if (spool == null)
{
    <PageHeader Title="@AppResources.Spool_NotFoundTitle" Icon="Lucide.Package" />

    <div class="card empty">
        @AppResources.Spool_NotFoundMessage
        <div><a class="btn btn-outline btn-sm" href="spools">@AppResources.Spools_Title</a></div>
    </div>
}
else
{
    <PageHeader Title="@Title" Icon="Lucide.Package">
        <Subtitle><span class="mono small">@Key</span></Subtitle>
    </PageHeader>

    <div class="stack">

        @if (canEdit && edit != null)
        {
            <div class="card spool-card">
                <div class="section-title">@AppResources.Main_SpoolSection</div>

                <div class="spool-head">
                    <SpoolSwatch Info="info" />
                    <div class="spool-head-text">
                        <div class="spool-title">@Title</div>
                        <div class="small subtle">@(string.Format(spool.IsManual ? AppResources.Spool_AddedManuallyAt : AppResources.Spool_LastScanned, spool.LastScanned.ToString("yyyy-MM-dd HH:mm")))</div>
                        @if (spool.SentTo is { } sentTo)
                        {
                            <div class="small subtle">@(string.Format(AppResources.Spool_SentTo, sentTo.DisplayName(), spool.SentAt?.ToString("yyyy-MM-dd HH:mm")))</div>
                        }
                    </div>
                </div>

                <SpoolEditForm Model="edit" Fields="Manager.EditFields" Locations="Manager.ExistingLocations" CancelText="@AppResources.Common_Back" OnSave="SaveAsync" OnCancel="GoBack" />
            </div>
        }

        @if (info != null)
        {
            <SpoolInfoCard Info="info" />
        }

        @if (Scanner.SendTarget is { } target)
        {
            <button class="btn btn-secondary btn-block" disabled="@Scanner.IsSendingSpools" @onclick="SendAsync"><Blazicon Svg="Lucide.Send" /> @(Scanner.IsSendingSpools ? AppResources.Spools_Sending : string.Format(AppResources.Spools_SendTo, target.Backend.DisplayName()))</button>
        }

        <button class="btn btn-tertiary btn-block" @onclick="DeleteAsync"><Blazicon Svg="Lucide.Trash" /> @AppResources.Spool_Delete</button>

    </div>
}
