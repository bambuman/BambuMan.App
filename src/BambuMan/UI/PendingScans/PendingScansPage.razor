@page "/pending"
@inherits ObservingComponentBase

<PageHeader Title="Queued scans" Icon="Lucide.Server">
    <Subtitle>@Vm.CountText</Subtitle>
    <Actions>
        <button class="btn btn-secondary" disabled="@(!Vm.HasSendable || Queue.IsSending)" @onclick="SendAllAsync"><Blazicon Svg="Lucide.RefreshCw" /> Send all</button>
        <button class="btn btn-tertiary" disabled="@(Vm.TotalCount == 0)" @onclick="DiscardAllAsync"><Blazicon Svg="Lucide.Trash" /> Discard all</button>
    </Actions>
</PageHeader>

<div class="stack">

    <div class="card">
        @if (Vm.TotalCount == 0)
        {
            <div class="empty">
                No scans are waiting. A spool read while the inventory server can't be reached is kept here and sent once it's back.
                <div><a class="btn btn-outline btn-sm" href="">Scanner</a></div>
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var item in Vm.Items)
                {
                    <div class="list-row" @key="item.Id">
                        <div class="list-row-main">
                            <div class="swatch round" style="background: @SpoolSwatch.ToCss(item.Color)"></div>
                            <div class="list-row-text">
                                <div class="list-row-title">@item.Title</div>
                                <div class="list-row-sub">@item.Subtitle</div>
                                @if (item.Error != null)
                                {
                                    <div class="list-row-error">Rejected: @item.Error</div>
                                }
                            </div>
                        </div>
                        @if (item.CanSend)
                        {
                            <button class="btn btn-secondary btn-sm" aria-label="Send @item.Title" disabled="@Queue.IsSending" @onclick="() => SendAsync(item.Id)"><Blazicon Svg="Lucide.RefreshCw" /></button>
                        }
                        <button class="btn btn-secondary btn-sm" aria-label="Discard @item.Title" @onclick="() => DiscardAsync(item.Id)"><Blazicon Svg="Lucide.Trash" /></button>
                    </div>
                }
            </div>
        }
    </div>

    @if (Vm.TotalCount > 0)
    {
        <div class="small subtle">
            Queued scans are sent automatically, oldest first, as soon as the inventory server is reachable again. A rejected scan
            (e.g. no matching filament) stays here until you send it again or discard it.
        </div>
    }

</div>
