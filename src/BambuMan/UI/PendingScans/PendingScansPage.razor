@page "/pending"
@inherits ObservingComponentBase

<PageHeader Title="@AppResources.Pending_Title" Icon="Lucide.Server">
    <Subtitle>@Vm.CountText</Subtitle>
    <Actions>
        <button class="btn btn-secondary" disabled="@(!Vm.HasSendable || Queue.IsSending)" @onclick="SendAllAsync"><Blazicon Svg="Lucide.RefreshCw" /> @AppResources.Pending_SendAll</button>
        <button class="btn btn-tertiary" disabled="@(Vm.TotalCount == 0)" @onclick="DiscardAllAsync"><Blazicon Svg="Lucide.Trash" /> @AppResources.Pending_DiscardAll</button>
    </Actions>
</PageHeader>

<div class="stack">

    <div class="card">
        @if (Vm.TotalCount == 0)
        {
            <div class="empty">
                @AppResources.Pending_Empty
                <div><a class="btn btn-outline btn-sm" href="">@AppResources.Nav_Scanner</a></div>
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var item in Vm.Items)
                {
                    <div class="list-row" @key="item.Id">
                        <div class="list-row-main">
                            <div class="swatch round" style="background: @SpoolSwatch.ToCss(item.Color)"></div>
                            <div class="list-row-text">
                                <div class="list-row-title">@item.Title</div>
                                <div class="list-row-sub">@item.Subtitle</div>
                                @if (item.Error != null)
                                {
                                    <div class="list-row-error">@(string.Format(AppResources.Pending_Rejected, item.Error))</div>
                                }
                            </div>
                        </div>
                        @if (item.CanSend)
                        {
                            <button class="btn btn-secondary btn-sm" aria-label="@(string.Format(AppResources.Pending_Send, item.Title))" disabled="@Queue.IsSending" @onclick="() => SendAsync(item.Id)"><Blazicon Svg="Lucide.RefreshCw" /></button>
                        }
                        <button class="btn btn-secondary btn-sm" aria-label="@(string.Format(AppResources.Pending_Discard, item.Title))" @onclick="() => DiscardAsync(item.Id)"><Blazicon Svg="Lucide.Trash" /></button>
                    </div>
                }
            </div>
        }
    </div>

    @if (Vm.TotalCount > 0)
    {
        <div class="small subtle">
            @AppResources.Pending_Footer
        </div>
    }

</div>
