@page "/add-spool"
@inherits ObservingComponentBase

<PageHeader Title="@AppResources.AddSpool_Title" Icon="Lucide.PackagePlus">
    <Subtitle>@AppResources.AddSpool_Subtitle</Subtitle>
</PageHeader>

<div class="stack">

    <Banner Kind="error" Label="@AppResources.Main_BannerError" Icon="Lucide.CircleAlert" Message="@Vm.ErrorMessage" />

    @if (!canAdd)
    {
        <div class="card empty">
            @(Scanner.ActiveManager.CanEditSpools
                ? string.Format(AppResources.AddSpool_ConnectFirst, Scanner.ViewModel.BackendLabel)
                : AppResources.AddSpool_StoreLocallyFirst)
            <div><a class="btn btn-outline btn-sm" href="">@AppResources.Settings_BackToScanner</a></div>
        </div>
    }
    else if (Vm.IsPicking)
    {
        <div class="filters">
            <FormField Icon="Lucide.Search" Class="filter-search" HasValue="!string.IsNullOrEmpty(Vm.Search)" OnClear="() => Vm.Search = null">
                <input type="text" enterkeyhint="search" placeholder="@AppResources.AddSpool_Search" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="@AppResources.AddSpool_Search" @bind="Vm.Search" @bind:event="oninput" />
            </FormField>
        </div>

        <div class="card">
            @if (Vm.Results.Count == 0)
            {
                <div class="empty">@AppResources.AddSpool_NoMatch</div>
            }
            else
            {
                <div class="list">
                    @foreach (var item in Vm.Results)
                    {
                        <button type="button" class="list-row pick-row" @key="item.Filament.Id" @onclick="() => Select(item)">
                            <SpoolSwatch Info="item.Display" Class="round" />
                            <div class="list-row-text">
                                <div class="list-row-title">@item.Title</div>
                                <div class="list-row-sub">@item.Subtitle</div>
                            </div>
                        </button>
                    }
                </div>

                @if (Vm.MatchCount > Vm.Results.Count)
                {
                    <div class="small subtle">@(string.Format(AppResources.AddSpool_ShowingCount, Vm.Results.Count, Vm.MatchCount))</div>
                }
            }
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title"><Blazicon Svg="Lucide.Package" /> @AppResources.AddSpool_NotInList</div>
                <button class="btn btn-secondary btn-sm" @onclick="SelectUnknown">@AppResources.Spools_UnknownFilament</button>
            </div>
            <div class="small subtle">@AppResources.AddSpool_UnknownHint</div>
        </div>
    }
    else if (Vm.Edit != null)
    {
        <div class="card spool-card">
            <div class="section-title">@AppResources.Main_SpoolSection</div>

            <div class="spool-head">
                @if (Vm.Selected != null)
                {
                    <SpoolSwatch Info="Vm.Selected.Display" />
                }
                else
                {
                    <div class="swatch" style="background: @Vm.UnknownColor"></div>
                }
                <div class="spool-head-text">
                    <div class="spool-title">@(Vm.Selected?.Title ?? AppResources.Spools_UnknownFilament)</div>
                    <div class="small subtle">@(Vm.Selected?.Subtitle ?? AppResources.AddSpool_NotInCatalog)</div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Vm.ClearSelection">@AppResources.AddSpool_Change</button>
            </div>

            <SpoolEditForm Model="Vm.Edit" Fields="Scanner.ActiveManager.EditFields" Locations="Scanner.ActiveManager.ExistingLocations" SaveText="@AppResources.AddSpool_Title" Saving="Vm.Saving" OnSave="SaveAsync" OnCancel="GoBack">
                @if (Vm.IsUnknown)
                {
                    <FormField Label="@AppResources.Common_Material" Icon="Lucide.Package" Error="@Vm.UnknownMaterialError" Class="span-2">
                        <input type="text" list="@materialListId" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="@AppResources.AddSpool_MaterialPlaceholder" @bind="Vm.UnknownMaterial" />
                        <datalist id="@materialListId">
                            @foreach (var material in Vm.Materials)
                            {
                                <option value="@material"></option>
                            }
                        </datalist>
                    </FormField>

                    <FormField Label="@AppResources.Common_Colour" Icon="Lucide.Palette">
                        <input type="color" @bind="Vm.UnknownColor" />
                    </FormField>

                    <FormField Label="@AppResources.AddSpool_LabelWeight" Icon="Lucide.Weight" Error="@Vm.UnknownLabelWeightError">
                        <input type="number" inputmode="numeric" step="1" min="1" @bind="Vm.UnknownLabelWeight" />
                    </FormField>
                }
            </SpoolEditForm>
        </div>
    }

</div>
