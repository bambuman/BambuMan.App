@page "/"
@inherits ObservingComponentBase

<PageHeader Title="@AppResources.Main_Title" Icon="Lucide.Nfc">
    <Subtitle>
        <span class="dot @StatusDot"></span> @StatusText
    </Subtitle>
    <Actions>
        @if (Vm.IsTest)
        {
            <button class="btn btn-outline" @onclick="Scanner.TestTagAsync"><Blazicon Svg="Lucide.FlaskConical" /> @AppResources.Main_TestTag</button>
        }
    </Actions>
</PageHeader>

<div class="stack">

    <Banner Kind="version" Icon="Lucide.Download" Message="@(Vm.NewVersionAvailable ? Vm.NewVersionText : null)" />

    <div class="stats">
        <div class="card stat stat-@(Vm.SettingsOk ? "success" : "error")">
            <div class="stat-label"><Blazicon Svg="Lucide.Settings2" /> @AppResources.Main_StatSettings</div>
            <div class="stat-value"><span class="stat-long">@(Vm.SettingsOk ? AppResources.Main_SettingsConfigured : AppResources.Main_SettingsIncomplete)</span><span class="stat-short">@(Vm.SettingsOk ? AppResources.Main_SettingsOk : AppResources.Main_SettingsMissing)</span></div>
            @if (Vm.SettingsOk)
            {
                <span class="pill success"><Blazicon Svg="Lucide.CircleCheck" /> @AppResources.Main_SettingsOk</span>
            }
            else
            {
                <a class="pill error" href="settings"><Blazicon Svg="Lucide.CircleAlert" /> @AppResources.Main_OpenSettings</a>
            }
        </div>

        <div class="card stat stat-@BackendPill.Kind">
            <div class="stat-label"><Blazicon Svg="Lucide.Server" /> @AppResources.Main_StatInventory</div>
            <div class="stat-value"><span class="stat-long">@Vm.BackendLabel</span><span class="stat-short">@(Vm.Backend == InventoryBackend.NoBackend ? AppResources.Main_BackendLocal : Vm.BackendLabel)</span></div>
            <span class="pill @BackendPill.Kind">@BackendPill.Text</span>
        </div>

        <div class="card stat stat-@NfcStatus">
            <div class="stat-label"><Blazicon Svg="Lucide.Nfc" /> NFC</div>
            <div class="stat-value">@Vm.NfcText</div>
            @if (!Vm.NfcIsEnabled)
            {
                <span class="pill error"><Blazicon Svg="Lucide.CircleX" /> @AppResources.Main_NfcOff</span>
            }
            else if (Vm.DeviceIsListening)
            {
                <span class="pill success"><Blazicon Svg="Lucide.Radio" /> @AppResources.Main_NfcListening</span>
            }
            else
            {
                <span class="pill">@AppResources.Main_NfcIdle</span>
            }
        </div>

        <div class="card stat stat-primary">
            <div class="stat-label"><Blazicon Svg="Lucide.Package" /> @AppResources.Main_StatSession</div>
            <div class="stat-value">@SessionSpoolCount<span class="stat-long">&nbsp;@(SessionSpoolCount == 1 ? AppResources.Main_SpoolOne : AppResources.Main_SpoolMany)</span></div>
            <span class="pill primary">@(string.Format(InventoryService.Inventory.Count == 1 ? AppResources.Main_MaterialCountOne : AppResources.Main_MaterialCountMany, InventoryService.Inventory.Count))</span>
        </div>
    </div>

    @if (Vm.SpoolmanConnecting)
    {
        <div class="card connecting">
            <div class="spinner"></div>
            @AppResources.Main_Connecting
        </div>
    }

    @if (Vm.HasInventoryItems)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title"><Blazicon Svg="Lucide.Package" /> @AppResources.Main_SessionInventory</div>
                <button class="btn btn-secondary btn-sm" @onclick="Scanner.ClearInventoryAsync"><Blazicon Svg="Lucide.Eraser" /> @AppResources.Main_ClearInventory</button>
            </div>
            <div class="chips">
                @foreach (var item in InventoryService.Inventory)
                {
                    <span class="chip" style="background: @item.Color">@item.Material <span class="chip-count">× @item.Quantity</span></span>
                }
            </div>
        </div>
    }

    <Banner Kind="error" Label="@AppResources.Main_BannerError" Icon="Lucide.CircleAlert" Message="@Vm.ErrorMessage" />
    <Banner Kind="success" Label="@AppResources.Main_BannerSuccess" Icon="Lucide.CircleCheck" Message="@Vm.SuccessMessage" />
    <Banner Kind="info" Label="@AppResources.Main_BannerInfo" Icon="Lucide.Info" Message="@Vm.InfoMessage" />

    @if (Vm.ShowSpoolEdit)
    {
        <div class="card spool-card">
            <div class="section-title">@AppResources.Main_SpoolSection</div>

            <div class="spool-head">
                <SpoolSwatch Info="SpoolColors" />
                <div class="spool-head-text">
                    <div class="spool-title">@(Vm.Spool?.Material ?? AppResources.Main_SpoolInfo)</div>
                    @if (!string.IsNullOrEmpty(Vm.Spool?.TrayUid))
                    {
                        <div class="small subtle mono">@Vm.Spool.TrayUid</div>
                    }
                </div>
            </div>

            <SpoolEditForm @ref="spoolEditForm" Model="Vm.SpoolEdit" Fields="Vm.EditFields" Locations="Vm.ExistingLocations" OnSave="SaveAsync" OnCancel="Scanner.CloseSpool" />
        </div>
    }

    @* Read-only counterpart of the card above, shown when the backend can't save edits. *@
    @if (Vm.ShowSpoolInfo && Vm.SpoolInfo != null)
    {
        <SpoolInfoCard Info="Vm.SpoolInfo" OnClose="Scanner.CloseSpool" />
    }

    @if (!Vm.SpoolmanConnecting && !Vm.ShowSpoolEdit && !Vm.ShowSpoolInfo)
    {
        <div class="card ready">
            <div class="ready-icon"><Blazicon Svg="Lucide.Nfc" /></div>
            <div>
                <div class="ready-title">@(Vm.NfcIsEnabled ? AppResources.Main_ReadyTitle : AppResources.Main_NfcOffTitle)</div>
                <div class="muted small">
                    @(Vm.NfcIsEnabled
                        ? AppResources.Main_ReadyDescription
                        : AppResources.Main_NfcOffDescription)
                </div>
            </div>
        </div>
    }

    @if (Vm.ShowLocalSpools)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title"><Blazicon Svg="Lucide.Boxes" /> @Vm.LocalSpoolsText <span class="pill primary">@Vm.LocalSpoolsCount</span></div>
                <div class="card-actions">
                    @if (Vm.LocalSpoolsStored)
                    {
                        <a class="btn btn-secondary btn-sm" href="spools"><Blazicon Svg="Lucide.List" /> @AppResources.Main_List</a>
                        <button class="btn btn-secondary btn-sm" @onclick="Scanner.ImportCsvAsync"><Blazicon Svg="Lucide.FileUp" /> @AppResources.Common_ImportCsv</button>
                    }
                    <button class="btn btn-secondary btn-sm" @onclick="Scanner.ExportCsvAsync"><Blazicon Svg="Lucide.FileDown" /> @AppResources.Common_ExportCsv</button>
                </div>
            </div>
            <div class="small subtle">
                @(Vm.LocalSpoolsStored ? AppResources.Main_LocalSpoolsStoredHint : AppResources.Main_LocalSpoolsSessionHint)
            </div>
        </div>
    }

    @if (Vm.ShowInventoryOptions)
    {
        <div class="card">
            <div class="toggle-list">
                <ToggleRow Title="@AppResources.Common_OverrideLocationTitle" Description="@AppResources.Main_OverrideLocationDescription" @bind-Value="Vm.OverrideLocationOnRead" />
            </div>
        </div>
    }

    @if (Vm.ShowLogsOnMainPage)
    {
        <LogPanel Logs="Vm.Logs" OnClear="Vm.Logs.Clear" OnEmail="Scanner.EmailLogsAsync" />
    }

</div>
