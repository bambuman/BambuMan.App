@page "/settings"
@inherits ObservingComponentBase
@using BambuMan.UI.Consent

<PageHeader Title="@AppResources.Settings_Title" Icon="Lucide.Settings">
    <Subtitle>@AppResources.Settings_Subtitle</Subtitle>
</PageHeader>

<div class="stack">

    <div class="card">
        <div class="section-title">@AppResources.Settings_InventoryBackend</div>

        <div class="segmented" role="radiogroup">
            @foreach (var backend in Enum.GetValues<InventoryBackend>())
            {
                <button type="button" role="radio" aria-checked="@(Vm.InventoryBackend == backend)" class="@(Vm.InventoryBackend == backend ? "selected" : null)" @onclick="() => SelectBackend(backend)">
                    @backend.DisplayName()
                </button>
            }
        </div>

        <p class="small subtle">
            @switch (Vm.InventoryBackend)
            {
                case InventoryBackend.Bambuddy:
                    @:@AppResources.Settings_BackendBambuddyDescription
                    break;
                case InventoryBackend.Spoolman:
                    @:@AppResources.Settings_BackendSpoolmanDescription
                    break;
                default:
                    @:@AppResources.Settings_BackendNoneDescription
                    break;
            }
        </p>
    </div>

    @if (Vm.ShowServerUrl)
    {
        <div class="card">
            <div class="section-title">@AppResources.Settings_Connection</div>

            <div class="stack">
                <div class="field-row">
                    <FormField Label="@AppResources.Settings_ServerUrl" Icon="Lucide.Link" Error="@Vm.ServerUrlError">
                        <input type="url" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="http://192.168.1.10:8000" @bind="Vm.ServerUrl" @bind:after="Persist" />
                    </FormField>
                    <button type="button" class="btn btn-accent-outline" @onclick='() => ScanQrAsync("server_url")'><Blazicon Svg="Lucide.QrCode" /> @AppResources.Settings_ScanQr</button>
                </div>

                @if (Vm.IsBambuddy)
                {
                    <div class="field-row">
                        <FormField Label="@AppResources.Settings_BambuddyApiKey" Icon="Lucide.Key" Error="@Vm.BambuddyApiKeyError" HasValue="!string.IsNullOrEmpty(Vm.BambuddyApiKey)" OnClear="ClearApiKey">
                            <input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" @bind="Vm.BambuddyApiKey" @bind:after="Persist" />
                        </FormField>
                        <button type="button" class="btn btn-accent-outline" @onclick='() => ScanQrAsync("bambuddy_key")'><Blazicon Svg="Lucide.QrCode" /> @AppResources.Settings_ScanQr</button>
                    </div>
                }

                <div>
                    <button type="button" class="btn btn-outline" disabled="@testingConnection" @onclick="TestConnectionAsync">
                        <Blazicon Svg="Lucide.Plug" /> @(testingConnection ? AppResources.Settings_Testing : string.Format(AppResources.Settings_TestUrl, Vm.InventoryBackend.DisplayName()))
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="section-title">@AppResources.Settings_TextSize</div>

        <div class="segmented compact" role="radiogroup" aria-label="@AppResources.Settings_TextSize">
            @foreach (var scale in Enum.GetValues<TextScale>())
            {
                <button type="button" role="radio" aria-checked="@(Vm.TextScale == scale)" class="@(Vm.TextScale == scale ? "selected" : null)" @onclick="() => SelectTextScale(scale)">
                    @scale.DisplayName()
                </button>
            }
        </div>

        <p class="small subtle">@AppResources.Settings_TextSizeDescription</p>
    </div>

    <div class="card">
        <div class="section-title">@AppResources.Settings_Language</div>

        <FormField Icon="Lucide.Globe">
            <select aria-label="@AppResources.Settings_Language" @bind="Vm.Language" @bind:after="SelectLanguage">
                @foreach (var language in Enum.GetValues<AppLanguage>())
                {
                    <option value="@language">@(language.NativeName() ?? AppResources.Settings_LanguageSystemDefault)</option>
                }
            </select>
        </FormField>

        <p class="small subtle">@AppResources.Settings_LanguageDescription</p>
    </div>

    <div class="card">
        <div class="section-title">@AppResources.Settings_Scanning</div>

        <div class="toggle-list">
            <ToggleRow Title="@AppResources.Settings_UploadTitle" Description="@AppResources.Settings_UploadDescription" Value="Vm.FullTagScanAndUpload" ValueChanged="SetFullTagScanAndUpload">
                <TitleExtra>
                    <button type="button" class="info-button" aria-label="@AppResources.Settings_UploadInfo" @onclick="ShowConsentInfo"><Blazicon Svg="Lucide.Info" /></button>
                </TitleExtra>
            </ToggleRow>

            @if (Vm.IsNoBackend)
            {
                <ToggleRow Title="@AppResources.Settings_StoreLocallyTitle" Description="@AppResources.Settings_StoreLocallyDescription" Value="Vm.StoreSpoolsLocally" ValueChanged="v => Set(() => Vm.StoreSpoolsLocally = v)" />
            }

            @if (Vm.ShowInventoryOptions)
            {
                <ToggleRow Title="@AppResources.Settings_UnknownFilamentTitle" Description="@AppResources.Settings_UnknownFilamentDescription" Value="Vm.UnknownFilamentEnabled" ValueChanged="v => Set(() => Vm.UnknownFilamentEnabled = v)" />
            }

            <ToggleRow Title="@AppResources.Settings_ShowLogsTitle" Value="Vm.ShowLogsOnMainPage" ValueChanged="v => Set(() => Vm.ShowLogsOnMainPage = v)" />

            @if (Vm.CanEditSpools)
            {
                <ToggleRow Title="@AppResources.Settings_ShowKeyboardTitle" Description="@AppResources.Settings_ShowKeyboardDescription" Value="Vm.ShowKeyboardOnSpoolRead" ValueChanged="v => Set(() => Vm.ShowKeyboardOnSpoolRead = v)" />

                <ToggleRow Title="@AppResources.Common_OverrideLocationTitle" Description="@AppResources.Settings_OverrideLocationDescription" Value="Vm.OverrideLocationOnRead" ValueChanged="v => Set(() => Vm.OverrideLocationOnRead = v)" />
            }
        </div>
    </div>

    @* Read spools that are only shown, not kept, have nothing to put the defaults on. *@
    @if (Vm.CanEditSpools)
    {
        <div class="card">
            <div class="section-title">@AppResources.Settings_Defaults</div>

            <div class="form-grid collapse">
                @if (Vm.ShowBuyDateAndLotNr)
                {
                    <FormField Label="@AppResources.Spool_BuyDate" Icon="Lucide.Calendar" HasValue="Vm.BuyDate != null" OnClear="() => Set(() => Vm.BuyDate = null)">
                        <input type="date" @bind="Vm.BuyDate" @bind:after="Persist" />
                    </FormField>
                }

                <FormField Label="@AppResources.Spool_Price" Icon="Lucide.Tag" Error="@Vm.DefaultPriceError" HasValue="Vm.DefaultPrice != null" OnClear="() => Set(() => Vm.DefaultPrice = null)">
                    <input type="number" inputmode="decimal" step="any" min="0" @bind="Vm.DefaultPrice" @bind:after="Persist" />
                </FormField>

                @if (Vm.ShowBuyDateAndLotNr)
                {
                    <FormField Label="@AppResources.Spool_LotNr" Icon="Lucide.Hash" HasValue="!string.IsNullOrEmpty(Vm.DefaultLotNr)" OnClear="() => Set(() => Vm.DefaultLotNr = null)">
                        <input type="text" @bind="Vm.DefaultLotNr" @bind:after="Persist" />
                    </FormField>
                }

                <div class="field-row @(Vm.ShowBuyDateAndLotNr ? null : "span-2")">
                    <FormField Label="@AppResources.Spool_Location" Icon="Lucide.MapPin" HasValue="!string.IsNullOrEmpty(Vm.DefaultLocation)" OnClear="() => Set(() => Vm.DefaultLocation = null)">
                        <input type="text" list="default-locations" autocomplete="off" @bind="Vm.DefaultLocation" @bind:after="Persist" />
                        <datalist id="default-locations">
                            @foreach (var location in Vm.ExistingLocations)
                            {
                                <option value="@location"></option>
                            }
                        </datalist>
                    </FormField>
                    @if (Vm.ShowInventoryOptions)
                    {
                        <button type="button" class="btn btn-accent-outline" aria-label="@AppResources.Settings_RefreshLocations" @onclick="RefreshLocationsAsync"><Blazicon Svg="Lucide.RefreshCw" /></button>
                    }
                </div>
            </div>
        </div>
    }

    <a class="btn btn-primary btn-block" href=""><Blazicon Svg="Lucide.Nfc" /> @AppResources.Settings_BackToScanner</a>

</div>

<TagUploadConsentDialog Visible="consentVisible" Dismissible="consentDismissible" OnResult="OnConsentResultAsync" OnDismissed="() => consentVisible = false" />
