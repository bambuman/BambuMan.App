@using BambuMan.Shared.Resources.Strings

<div class="card spool-card">
    <div class="section-title">@AppResources.Main_SpoolInfo</div>

    <div class="spool-head">
        <SpoolSwatch Info="Info" />
        <div class="spool-head-text">
            <div class="spool-title">@(Info.Rows.FirstOrDefault(x => x.Label == SharedResources.SpoolInfo_Material)?.Value ?? AppResources.Main_SpoolSection)</div>
            @if (!Info.Matched)
            {
                <div class="small subtle">@AppResources.Spool_NotInCatalog</div>
            }
        </div>
    </div>

    @* Rows are built in SpoolDisplayInfo.From, which omits anything the tag didn't carry. *@
    <dl class="info-rows">
        @foreach (var row in Info.Rows)
        {
            <dt>@row.Label</dt>
            <dd>@row.Value</dd>
        }
    </dl>

    @if (OnClose.HasDelegate)
    {
        <div class="form-actions">
            <button class="btn btn-tertiary" @onclick="OnClose">@AppResources.Common_Close</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SpoolDisplayInfo Info { get; set; } = null!;

    /// <summary>Shows a Close button when set.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
