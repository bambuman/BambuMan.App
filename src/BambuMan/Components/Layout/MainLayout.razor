@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AppNavigation AppNavigation
@using BambuMan.UI.Settings

@* The text size is a css variable on the shell, so every page, dialog and toast scales with it from the first render. *@
<div class="app-shell @(menuOpen ? "menu-open" : null)" data-text-scale="@textScale" style="--text-scale: @textScale.Factor().ToString(CultureInfo.InvariantCulture)">

    <header class="topbar">
        <button class="btn-icon" aria-label="Menu" @onclick="ToggleMenu"><Blazicon Svg="Lucide.Menu" /></button>
        <a class="brand" href="">
            <img src="img/logo.svg" alt="" />
            <span class="brand-name">BambuMan</span>
        </a>
    </header>

    <div class="sidebar-backdrop" @onclick="CloseMenu"></div>

    <NavMenu />

    <main class="content">
        <div class="page">
            @Body
        </div>
    </main>

    <ToastHost />
</div>

@code {
    private bool menuOpen;
    private TextScale textScale;

    protected override void OnInitialized()
    {
        textScale = SettingsPage.GetTextScale();

        AppNavigation.Attach(Navigation);
        Navigation.LocationChanged += OnLocationChanged;
        SettingsPage.SettingsChanged += OnSettingsChanged;
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        StateHasChanged();
    }

    private void OnSettingsChanged()
    {
        var scale = SettingsPage.GetTextScale();

        if (scale == textScale) return;

        textScale = scale;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SettingsPage.SettingsChanged -= OnSettingsChanged;
    }
}
