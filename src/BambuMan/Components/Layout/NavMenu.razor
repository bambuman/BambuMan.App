@using BambuMan.Shared.Managers
@using BambuMan.Shared.Resolvers
@using BambuMan.UI.Settings
@implements IDisposable
@inject NavigationManager Navigation
@inject IInventoryBackendResolver Backends

<aside class="sidebar">
    <div class="sidebar-inner">
        <a class="brand" href="">
            <img src="img/logo.svg" alt="" />
            <span class="brand-name">BambuMan</span>
        </a>

        <nav class="nav">
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                <Blazicon Svg="Lucide.Nfc" /> Scanner
            </NavLink>

            @* The device store is the only spool list the app keeps itself; the servers have their own UIs. With a server
               selected it stays listed while it still has spools, so they can be sent there. *@
            @if (ShowLocalSpools)
            {
                <NavLink class="nav-item" href="spools">
                    <Blazicon Svg="Lucide.Boxes" /> Spools
                </NavLink>
            }

            <NavLink class="nav-item" href="settings">
                <Blazicon Svg="Lucide.Settings" /> Settings
            </NavLink>

            <NavLink class="nav-item" href="logs">
                <Blazicon Svg="Lucide.ScrollText" /> Logs
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            @(string.IsNullOrEmpty(BuildVersionModel.CurrentBuildVersion) ? "BambuMan" : $"v{BuildVersionModel.CurrentBuildVersion}")
        </div>
    </div>
</aside>

@code {
    private NoBackendManager noBackend = null!;

    protected override void OnInitialized()
    {
        noBackend = (NoBackendManager)Backends.Resolve(InventoryBackend.NoBackend);

        // The Spools item depends on settings and, with a server selected, on spools being left; show or hide it as
        // soon as either changes, not on the next start.
        SettingsPage.SettingsChanged += OnSettingsChanged;
        Navigation.LocationChanged += OnLocationChanged;
        noBackend.OnSpoolsChanged += OnSettingsChanged;
    }

    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SettingsPage.SettingsChanged -= OnSettingsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        noBackend.OnSpoolsChanged -= OnSettingsChanged;
    }

    private bool ShowLocalSpools =>
        Preferences.Default.Get(SettingsPage.KeyStoreSpoolsLocally, false)
        && (SettingsPage.GetInventoryBackend() == InventoryBackend.NoBackend || noBackend is { IsStoreLoaded: true, Spools.Count: > 0 });
}
