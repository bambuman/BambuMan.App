<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\filaments.json" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\filaments.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- Messages the managers show and the spool info labels. The SharedResources class is generated at build time from
		     the English resx; SharedResources.<culture>.resx files beside it become satellite assemblies. -->
		<EmbeddedResource Update="Resources\Strings\SharedResources.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="BambuMan.Shared.Resources.Strings" StronglyTypedClassName="SharedResources" StronglyTypedFileName="$(IntermediateOutputPath)SharedResources.Designer.cs" PublicClass="true" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="RestSharp" Version="114.1.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bambuddy.Api\Bambuddy.Api.csproj" />
		<ProjectReference Include="..\SpoolMan.Api\SpoolMan.Api.csproj" />
	</ItemGroup>

</Project>
